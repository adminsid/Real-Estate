{
  "name": "real-estate-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Globally available Real Estate Workspace \u2014 PWA built for Cloudflare",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-icons.mjs && tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:dev": "wrangler dev worker/index.ts --port 8123",
    "dev:full": "wrangler dev -c ./wrangler.toml -c ./workers/crm/wrangler.toml -c ./workers/transactions/wrangler.toml --port 8123",
    "worker:deploy": "wrangler deploy worker/index.ts --env staging",
    "worker:deploy:prod": "wrangler deploy worker/index.ts",
    "worker:deploy:staging": "wrangler deploy worker/index.ts --env staging",
    "pages:deploy": "wrangler pages deploy dist",
    "search:build": "node scripts/mls-grid/build-staging.mjs",
    "search:typecheck": "tsc --noEmit -p workers/property-search/tsconfig.json",
    "search:dev": "npm run search:build && wrangler dev --config workers/property-search/wrangler.jsonc",
    "search:deploy:staging": "npm run search:build && wrangler deploy --config workers/property-search/wrangler.jsonc",
    "search:build:production": "node scripts/mls-grid/build-production.mjs",
    "search:typecheck:production": "tsc --noEmit -p workers/property-search/tsconfig.production.json",
    "search:deploy:production": "npm run search:build:production && wrangler deploy --config workers/property-search/wrangler.production.jsonc"
  },
  "dependencies": {
    "@cloudflare/kv-asset-handler": "^0.5.0",
    "better-auth": "^1.6.29",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "kysely": "^0.29.5",
    "kysely-d1": "^0.4.0",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
