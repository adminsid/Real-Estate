{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "prime-property-search",
  "main": "src/production-index.ts",
  "account_id": "4db3065ea9180585a8de09c7fcff6d83",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "search.primeamericany.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "images": {"binding":"IMAGES"},
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "IMAGE_TRANSFORM_LIMIT": "1000",
    "MEDIA_BATCH_SIZE": "96",
    "MEDIA_CONCURRENCY": "3",
    "FEED_BATCH_PAGES": "3",
    "APP_ENV": "production",
    "PUBLIC_ORIGIN": "https://search.primeamericany.com",
    "PUBLIC_RELEASE_ENABLED": "false",
    "APPROVED_IDX_ORIGIN": "https://search.primeamericany.com",
    "DISPLAY_REVIEW_COMPLETE": "false"
  },
  "ratelimits": [
    { "name": "SEARCH_RATE_LIMIT", "namespace_id": "8137001", "simple": { "limit": 300, "period": 60 } },
    { "name": "PHOTO_RATE_LIMIT", "namespace_id": "8137002", "simple": { "limit": 1200, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "SEARCH_DB",
      "database_name": "prime-property-search",
      "database_id": "7eb56a7c-7a05-4303-998a-4e38a8f7a5f3",
      "migrations_dir": "./production-migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SEARCH_MEDIA",
      "bucket_name": "prime-property-search-media"
    }
  ]
}
