{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "prime-property-search-staging",
  "main": "src/index.ts",
  "account_id": "4db3065ea9180585a8de09c7fcff6d83",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "preview-search.primeamericany.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "secrets": { "required": ["MLS_GRID_ACCESS_TOKEN"] },
  "vars": {
    "APP_ENV": "staging",
    "PUBLIC_ORIGIN": "https://preview-search.primeamericany.com",
    "ACCESS_TEAM_DOMAIN": "primeamerica.cloudflareaccess.com",
    "ACCESS_AUD": "aeb5d1a3e1aacaf377f99f5297ba88a71b1ac4d3fb6c7466a557897aea823755",
    "DATASET": "synthetic",
    "FEED_OPERATOR_EMAIL": "lama@primeamericany.com"
  },
  "d1_databases": [{
    "binding": "SEARCH_DB",
    "database_name": "prime-property-search-staging",
    "database_id": "47a4aef3-bc61-4b7c-9500-ae60e99dba55",
    "migrations_dir": "./migrations"
  }],
  "r2_buckets": [{ "binding": "SEARCH_MEDIA", "bucket_name": "prime-property-search-staging-media" }]
}
