{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "prime-property-search-staging",
  "main": "src/index.ts",
  "account_id": "4db3065ea9180585a8de09c7fcff6d83",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "preview-search.primeamericany.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "images": {"binding":"IMAGES"},
  "durable_objects":{"bindings":[{"name":"SOURCE_GATEWAY","class_name":"SourceGateway"}]},
  "migrations":[{"tag":"source-gateway-v1","new_sqlite_classes":["SourceGateway"]}],
  "queues":{
    "producers":[
      {"binding":"GALLERY_JOBS","queue":"prime-search-galleries"},
      {"binding":"COVER_JOBS","queue":"prime-search-covers"},
      {"binding":"VARIANT_JOBS","queue":"prime-search-variants"}
    ],
    "consumers":[
      {"queue":"prime-search-galleries","max_batch_size":1,"max_batch_timeout":0,"max_concurrency":1,"max_retries":5,"dead_letter_queue":"prime-search-media-dlq"},
      {"queue":"prime-search-covers","max_batch_size":1,"max_batch_timeout":0,"max_concurrency":1,"max_retries":5,"dead_letter_queue":"prime-search-media-dlq"},
      {"queue":"prime-search-variants","max_batch_size":4,"max_batch_timeout":1,"max_concurrency":2,"max_retries":5,"dead_letter_queue":"prime-search-media-dlq"},
      {"queue":"prime-search-media-dlq","max_batch_size":10,"max_batch_timeout":5,"max_concurrency":1,"max_retries":3}
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": [
      "MLS_GRID_ACCESS_TOKEN"
    ]
  },
  "vars": {
    "IMAGE_TRANSFORM_LIMIT": "100000",
    "PREPARED_MEDIA_ONLY": "false",
    "MEDIA_BATCH_SIZE": "96",
    "MEDIA_CONCURRENCY": "3",
    "FEED_BATCH_PAGES": "6",
    "PHOTO_IMPORT_MODE": "on-demand",
    "APP_ENV": "staging",
    "PUBLIC_ORIGIN": "https://preview-search.primeamericany.com",
    "ACCESS_TEAM_DOMAIN": "primeamerica.cloudflareaccess.com",
    "ACCESS_AUD": "aeb5d1a3e1aacaf377f99f5297ba88a71b1ac4d3fb6c7466a557897aea823755",
    "DATASET": "live",
    "FEED_OPERATOR_EMAIL": "lama@primeamericany.com",
    "LIVE_SYNC_ENABLED": "true",
    "LOCATION_REFRESH_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "SEARCH_DB",
      "database_name": "prime-property-search-staging",
      "database_id": "47a4aef3-bc61-4b7c-9500-ae60e99dba55",
      "migrations_dir": "./migrations"
    },
    {
      "binding": "LIVE_DB",
      "database_name": "prime-property-search",
      "database_id": "7eb56a7c-7a05-4303-998a-4e38a8f7a5f3",
      "migrations_dir": "./production-migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SEARCH_MEDIA",
      "bucket_name": "prime-property-search-staging-media"
    },
    {
      "binding": "LIVE_MEDIA",
      "bucket_name": "prime-property-search-media"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
