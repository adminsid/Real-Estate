{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "prime-search-media-processor",
  "main": "src/index.ts",
  "account_id": "4db3065ea9180585a8de09c7fcff6d83",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": true, "head_sampling_rate": 1},
  "containers": [{"class_name": "MediaProcessor", "image": "./container/Dockerfile", "image_build_context": "./container", "max_instances": 1, "instance_type": "basic"}],
  "durable_objects": {"bindings": [{"name": "PROCESSOR", "class_name": "MediaProcessor"}]},
  "migrations": [{"tag": "media-benchmark-v1", "new_sqlite_classes": ["MediaProcessor"]}],
  "r2_buckets": [{"binding": "MEDIA", "bucket_name": "prime-property-search-media"}],
  "d1_databases": [{"binding": "DB", "database_name": "prime-property-search", "database_id": "7eb56a7c-7a05-4303-998a-4e38a8f7a5f3"}]
}
